# Token cua bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Application ID (Discord Developer Portal > General Information)
DISCORD_CLIENT_ID=

# ID server cua ban (bat Developer Mode trong Discord, chuot phai vao server > Copy Server ID)
# Neu de trong, lenh se duoc dang ky global (cham, toi ~1 gio moi hien)
DISCORD_GUILD_ID=

# Duong dan file database (mac dinh ./data/casino.db)
DB_PATH=./data/casino.db

# Public origin for avatar URLs, and where figurine avatars are stored
PUBLIC_BASE_URL=https://casino.dash.id.vn
AVATAR_DIR=./data/avatars
